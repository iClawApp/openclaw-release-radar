{
  "name": "openclaw-release-radar",
  "version": "0.1.0",
  "description": "Release stability monitor for openclaw/openclaw — polls GitHub issues, scores releases via LLM.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test 'src/lib/*.test.ts'",
    "test:llm-baseurl": "npm run build && node scripts/llm-baseurl-smoke.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
