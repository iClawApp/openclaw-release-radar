# OpenClaw repo
GITHUB_OWNER=openclaw
GITHUB_REPO=openclaw

# GitHub PAT (read-only, public_repo scope). Optional but raises rate limits 60 → 5000/h.
GITHUB_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-compatible /chat/completions endpoint. Default is OpenAI itself.
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 with a namespaced
# model id, e.g. OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Server
PORT=8787
DB_PATH=./data/radar.db

# How often to refresh (minutes between runs). Allowed range: 1..600.
REFRESH_MINUTES=30

# How many releases to score and show (only stable releases — prereleases are filtered out)
RELEASES_LIMIT=10
